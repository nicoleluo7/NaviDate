# Copy to .env.local. No credentials are needed for the local planner.
APP_URL=http://localhost:3000
LOCAL_DB_PATH=.local/navidate.sqlite
DISABLE_EXTERNAL_APIS=false
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_DAILY_CALL_LIMIT=30
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE_DAILY_SESSION_LIMIT=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
PHOTON_AGENT_ADDRESS=
ORS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Browser Maps JavaScript key. Restrict it to your web origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server Places/Routes key. Restrict it to Places API (New) and Routes API.
GOOGLE_MAPS_API_KEY=

# Optional custom Google Maps map ID; demo defaults to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=
